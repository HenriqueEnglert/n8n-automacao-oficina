    {
      "parameters": {
        "jsCode": "// Puxa os dados JSON vindos do nó anterior\nconst payload = $(\"Request para IA\").first().json.choices[0].message.content;\nconst dados = JSON.parse(payload);\n\n// Mapeia o nome bonito que vai aparecer no texto e a chave exata do JSON\nconst mapaCampos = [\n  { rotulo: 'Placa', chave: 'placa' },\n  { rotulo: 'Modelo', chave: 'modelo' },\n  { rotulo: 'Quilometragem', chave: 'quilometragem' },\n  { rotulo: 'Oleo', chave: 'oleo' },\n  { rotulo: 'Quantidade de oleo', chave: 'quantidade_oleo' },\n  { rotulo: 'Filtro de oleo', chave: 'filtro_de_oleo' },\n  { rotulo: 'Filtro de combustível', chave: 'filtro_de_combustivel' },\n  { rotulo: 'Filtro de cabine', chave: 'filtro_de_cabine' },\n  { rotulo: 'Filtro de ar', chave: 'filtro_de_ar' },\n  { rotulo: 'Arruela', chave: 'arruela' },\n  { rotulo: 'Itens Extras', chave: 'itens_extras' }\n];\n\nlet mensagem = \"\";\n\n// Varre todos os campos\nmapaCampos.forEach(campo => {\n  const valor = dados[campo.chave];\n  \n  // Se o valor existir e não for \"null\" (em string), nulo ou vazio, ele adiciona a linha\n  if (valor !== null && valor !== undefined && valor !== '' && valor !== 'null') {\n    mensagem += `- ${campo.rotulo} : ${valor}\\n`;\n  }\n});\n\n// Retorna a mensagem perfeitamente formatada para ser usada no Telegram ou em outro nó\nreturn { \n  mensagem_formatada: mensagem.trim() \n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -752,
        -336
      ],
